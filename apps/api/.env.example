NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gfs_tms?schema=public
REDIS_URL=redis://localhost:6379

# Use a long random string in production (openssl rand -base64 48).
# Refresh tokens are opaque random values stored hashed in the DB.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# Live tracking simulator
SIMULATOR_ENABLED=true
SIMULATOR_TICK_MS=2000
# How many times faster than real time trucks move (30 = a 10h trip takes 20 min)
SIMULATOR_TIME_SCALE=30
# Keep the demo alive: auto pick-up assigned loads and tender new ones for idle crews
SIMULATOR_AUTOPILOT=true

# Use OSRM for real road routes on new shipments (falls back to great-circle estimate)
ROUTING_PROVIDER=osrm
OSRM_URL=https://router.project-osrm.org
