NODE_ENV=test
PORT=4000
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://ravshan@localhost:5432/gfs_tms_test?schema=public
REDIS_URL=redis://localhost:6379/1

# Use a long random string in production (openssl rand -base64 48).
# Refresh tokens are opaque random values stored hashed in the DB.
JWT_ACCESS_SECRET=test-only-access-secret-not-for-production-use
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# Live tracking simulator
SIMULATOR_ENABLED=false
SIMULATOR_TICK_MS=2000
# How many times faster than real time trucks move (120 = a 10h trip takes 5 min)
SIMULATOR_TIME_SCALE=30
SIMULATOR_AUTOPILOT=false

# Use OSRM for real road routes on new shipments (falls back to great-circle estimate)
ROUTING_PROVIDER=estimate
OSRM_URL=https://router.project-osrm.org
